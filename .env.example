# Copie para .env e ajuste. O docker compose e os comandos npm leem este arquivo.

# ---- PostgreSQL (usuário administrador: dono das tabelas, roda as migrações)
POSTGRES_USER=balcao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=balcao
DB_PORT=55432

# ---- Senhas dos papéis da aplicação (sem superusuário, sem BYPASSRLS)
APP_DB_PASSWORD=troque-esta-senha-da-api
WORKER_DB_PASSWORD=troque-esta-senha-do-worker

# ---- URLs usadas fora do Docker (npm run dev, npm run db:*)
ADMIN_DATABASE_URL=postgres://balcao:troque-esta-senha@localhost:55432/balcao
DATABASE_URL=postgres://balcao_app:troque-esta-senha-da-api@localhost:55432/balcao
WORKER_DATABASE_URL=postgres://balcao_worker:troque-esta-senha-do-worker@localhost:55432/balcao

# ---- API
API_PORT=4190
PORT=4190
# Gere com: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
LOGIN_RATE_LIMIT=5
DB_POOL_MAX=10
LOG_LEVEL=info
# Liga as contas de demonstração e o receptor de webhooks de teste. Desligue em produção.
DEMO_MODE=true

# ---- Worker
WORKER_CONCURRENCY=4
WORKER_POLL_MS=5000
WORKER_LOCK_TIMEOUT=300
WORKER_METRICS_PORT=4191
WHATSAPP_SIMULATED_LATENCY_MS=1500
JOB_BACKOFF_BASE_MS=2000
JOB_BACKOFF_MAX_MS=600000

# ---- Backup
BACKUP_RETENTION_DAYS=14
