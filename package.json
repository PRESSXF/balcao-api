{
  "name": "balcao-api",
  "version": "1.0.0",
  "private": true,
  "description": "Back-end multiempresa para pequenos negócios de serviço: agenda sem sobreposição garantida pelo PostgreSQL, isolamento por Row Level Security, fila de jobs no próprio banco, autenticação própria e operação com Docker em qualquer VM.",
  "license": "UNLICENSED",
  "author": "João Guilherme Gomes de Araújo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "dev:console": "vite --config console/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:console",
    "build:console": "tsc -p console/tsconfig.json && vite build --config console/vite.config.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-main.js",
    "db": "tsx src/cli/db.ts",
    "db:migrar": "tsx src/cli/db.ts migrar",
    "db:status": "tsx src/cli/db.ts status",
    "db:preparar": "tsx src/cli/db.ts preparar",
    "db:semear": "tsx src/cli/db.ts semear",
    "db:carga": "tsx src/cli/db.ts semear --carga",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p console/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "test:db": "bash scripts/test-db.sh",
    "explain": "tsx scripts/explain.ts",
    "carga": "tsx scripts/carga.ts",
    "backup": "bash scripts/backup.sh",
    "restore:verificar": "bash scripts/restore-verify.sh"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "autocannon": "^9.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
